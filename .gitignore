# Hilfsdateien und Bau-Ergebnisse (werden automatisch erzeugt)
node_modules
dist
*.log
*.local

# Geheime Schlüssel – NIE hochladen
.env
.env.*
!.env.example
supabase/.temp

# Kerncurricula-PDFs: urheberrechtlich geschützt, nicht ins öffentliche Repo
docs/*.pdf

# Referenzbilder: fremde Werke, nur zur Orientierung, nur lokal
refrences/

# Editor
.vscode/*
.idea
.DS_Store

# Referenz-Texte fremder Webseiten (nur lokal, nie ins öffentliche Repo)
Erklärungen referenz/

# Gekaufte Asset-Pakete (Sprout Lands): Lizenz verbietet Weitergabe – nur benutzte Einzelbilder kommen später ins Projekt
assets/

# Usability-Test (Bildschirmfotos, Bericht): nur lokal
usability-test/

# Datensicherungen der Datenbank (Pseudonyme, Lernstände): nur lokal
sicherung-*/
